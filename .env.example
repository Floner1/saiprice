# Copy to .env and fill in. .env is gitignored; this file is not.

# Required. SECRET_KEY has no default, so Django won't start without it.
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DB_NAME=saiprice
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional. Defaults shown are what you get if the line is absent, and they are
# the right values for local development. Render sets the hardening ones on.
# DEBUG=False
# ALLOWED_HOSTS=                      # comma-separated; must be set when DEBUG=False
# SECURE_HSTS_SECONDS=0
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
